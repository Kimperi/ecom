aws_region  = "eu-west-3"
aws_profile = "your-local-profile"
environment = "dev"

# First apply: keep this placeholder. Then copy the amplify_url output here and
# apply again so API Gateway permits only the real frontend origin.
frontend_origins = ["https://replace-after-first-apply.invalid"]

ses_source_email            = "sender@example.com"
seller_notification_email   = "seller@example.com"
delivery_fee_minor          = 5000
currency                    = "MAD"
log_retention_days          = 14
lambda_reserved_concurrency = -1

github_owner      = "Kimperi"
github_repository = "ecom"
github_branch     = "main"

# Only set these when the AWS account already has the provider or the repository
# uses GitHub's immutable OIDC subject format.
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
# github_oidc_subject      = "repo:owner@123/repository@456:ref:refs/heads/main"

additional_tags = {
  Owner = "your-name"
}
