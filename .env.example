# Default: local fixtures, no AWS account and no network API calls.
VITE_APP_MODE=demo

# Optional AWS adapter. Set VITE_APP_MODE=aws only with your own backend.
# These are PUBLIC frontend settings. Never add passwords, access keys or secrets.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Products URL is the API base; /products is appended by the adapter.
VITE_PRODUCTS_API_URL=
# Reviews and orders URLs include the endpoint path (/reviews and /orders).
VITE_REVIEWS_API_URL=
VITE_ORDERS_API_URL=
